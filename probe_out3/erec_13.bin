document.addEventListener("click", function (e) {

    const signOutLink = e.target.closest('a[href*="/Account/Login/LogOff"]');

    if (!signOutLink) {
        return;
    }

    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();

    window.location.assign(signOutLink.href);

}, true);



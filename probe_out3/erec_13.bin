<script nonce="L5z3jHPIvwkk2wUQTk17WcjGS1hS2Cfj87DZanlu9xM=" type="text/javascript">

   $(document).ready(function() {
    var imageUrl = "";
    var userId = $('span#userId').text(); //this is the id we will use to check for internal users 
  
    $('li a span.username').each(function() {
        var username = $(this).text();
        var words = username.split(' ');
        //console.log(username); this displays the name of the logged in user 
        for (var i = 0; i < words.length; i++) {
            words[i] = words[i].charAt(0).toUpperCase() + words[i].slice(1).toLowerCase();
        }

        var capitalizedUsername = words.join(' ');
        $(this).text(capitalizedUsername);
    });
    
  function handleNoImage() {
    var fullName = $(".username").text(); // Replace with the correct selector for your full name

    var words = fullName.split(" ");
    var initials = words.map(function(word) {
      return word.charAt(0);
    }).join("");

    $profilePicture.css("background-image", "none");
    $profilePicture.text(initials);
    $(".nav-link").attr("title", fullName);

    }
  
    });

  window.onload = function() {
    if (window.navigator.appName == "Microsoft Internet Explorer" || window.navigator.userAgent.indexOf("Trident") > 0) {
      var searchElement = document.getElementById("search");
      if (searchElement != null) searchElement.setAttribute("href", "");
    }
  };
  function setHeight() {
    var windowHeight = window.innerHeight - 140;
    var navbar = document.getElementById("navbar");
    if (navbar) {
      navbar.style.maxHeight = windowHeight + "px";
    }
  }
  window.addEventListener('resize', function(event) {
    setHeight();
  });
</script>
